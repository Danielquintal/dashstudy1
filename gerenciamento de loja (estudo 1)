--Criação de tabela para gerenciamento com os dados dos funcionários
CREATE TABLE gerenciamento_func(
	ID SERIAL PRIMARY KEY,
	nome VARCHAR(50) NOT NULL,
	email VARCHAR(50) UNIQUE NOT NULL,
	cargo VARCHAR(50),
	salario INT NOT NULL
);

