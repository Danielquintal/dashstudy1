-- Somatório dos salários da empresa = despesa fixa
SELECT SUM (salario) AS despesa_fixa
  FROM gerenciamento_func;

-- Filtragem os salários
SELECT FROM gerenciamento_func
	WHERE salario = '3000';

-- Filtragem de duas variáveis: no caso, quero saber se há gerente que recebe mais de 5000 reais de salário
SELECT FROM gerenciamento_func
	WHERE cargo = 'gerente' AND salario > '5000';

-- Somatório da média das despesas fixas
SELECT AVG (salario) AS media_despesa_fixa
  FROM gerenciamento_func;

-- Criação de outra tabela com contas a pagar --
CREATE TABLE contas_apagar(
	ID SERIAL PRIMARY KEY,
		nome VARCHAR(50) NOT NULL,
		vencimento VARCHAR(50),
		VALOR INT NOT NULL	
);

