-- Junção das duas tabelas
SELECT 
	produtos.nome, 
	produtos.preco, 
	produtos.estoque,
	produtos.categoria_id,
	categorias.nome
		FROM produtos
			INNER JOIN categorias
				ON produtos.id = categorias.id;

-- Visualizar os itens que possuem o preço maior que 50 reais
SELECT * FROM produtos
	WHERE preco > '50'
		ORDER BY preco ASC;

-- Selecionei na tabela produtos os itens que tem o maior preço, deixei apenas os itens que se enquadram na categoria_id 2
SELECT nome, preco 
	FROM produtos
		WHERE preco > ALL
				(SELECT preco FROM produtos WHERE categoria_id = '2');



